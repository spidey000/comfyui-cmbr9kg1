1,553.92991016187],"size":[249.83156509788734,179.92841659864428],"flags":{},"order":10,"mode":0,"inputs":[],"outputs":[],"title":"Input Scale","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["This workflow will slightly crop your image to ensure its dimensions are divisible by 16 (even if you don't turn on the scale switch), so you don't need to manually adjust it.\n\nIf you turn on the scale switch, it will scale the *longest edge* of your image to the length you specify.\n\nFor example, if you set the input scale to 1920 and provide an image of size 2560x1440, it will get downscaled to 1920x1080 then slightly cropped to 1920x1072 so it's divisible by 16."],"color":"#233","bgcolor":"#355"},{"id":325,"type":"MarkdownNote","pos":[-1173.7591138888426,784.212728063533],"size":[223.89785577899175,126.57907171405941],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"CFG?","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["Set CFG > 1 if you're trying to REMOVE something from the person (e.g. clothes).\n\nThis only works with the raw model + turbo model at 0.6 strength.\n\nUsing a nude reference image is easier because you can just add things instead, even if you're making SFW images."],"color":"#233","bgcolor":"#355"}],"links":[[1044,39,0,88,1,"VAE"],[1045,39,0,8,1,"VAE"],[1046,8,0,60,0,"IMAGE"],[1150,264,0,262,3,"INT"],[1152,78,0,262,0,"IMAGE"],[1440,262,0,88,0,"IMAGE"],[1441,288,0,262,2,"BOOLEAN"],[1442,260,0,297,0,"MODEL"],[1456,38,0,317,0,"CLIP"],[1457,38,0,318,0,"CLIP"],[1461,297,0,319,0,"MODEL"],[1466,319,0,320,0,"MODEL"],[1467,317,0,320,1,"CONDITIONING"],[1468,318,0,320,2,"CONDITIONING"],[1472,321,0,320,7,"FLOAT"],[1474,262,0,318,1,"IMAGE"],[1475,262,0,317,1,"IMAGE"],[1476,322,0,8,0,"LATENT"],[1477,320,0,322,3,"LATENT"],[1479,321,0,322,7,"FLOAT"],[1480,318,0,322,2,"CONDITIONING"],[1481,317,0,322,1,"CO