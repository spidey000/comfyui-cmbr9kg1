,-99.7719525049405],"size":[328.1134227872601,82],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[{"name":"MODEL","type":"MODEL","links":[1442]}],"properties":{"cnr_id":"comfy-core","ver":"0.20.3","Node name for S&R":"UNETLoader"},"widgets_values":["lustifyNSFWCheckpoint_v10Krea2.safetensors","default"],"color":"#223","bgcolor":"#335"},{"id":38,"type":"CLIPLoader","pos":[-825.3294986032793,20.26330819087166],"size":[327.97919148164453,110],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[{"name":"CLIP","type":"CLIP","slot_index":0,"links":[1456,1457]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.48","Node name for S&R":"CLIPLoader","models":[{"name":"qwen_2.5_vl_7b_fp8_scaled.safetensors","url":"https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors","directory":"text_encoders"}],"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65,"widget_ue_connectable":{}},"widgets_values":["qwen3vl_4b_bf16.safetensors","krea2","default"],"color":"#223","bgcolor":"#335"},{"id":39,"type":"VAELoader","pos":[-823.653326703662,169.97024355686332],"size":[325.2847801238372,58],"flags":{},"order":3,"mode":0,"inputs":[],"outputs":[{"name":"VAE","type":"VAE","slot_index":0,"links":[1044,1045]}],"properties":{"cnr_id":"comfy-core","ver":"0.3.48","Node name for S&R":"VAELoader","models":[{"name":"qwen_image_vae.safetensors","url":"https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/vae/qwen_image_vae.safetensors","directory":"vae"}],"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65,"widget_ue_connectable":{}},"widgets_values":["wan21_vae_fp32.safetensors"],"color":"#223","bgcolor":"#335"},{"id":326,"type":"MarkdownNote","pos":[-1093.5058298564145,-138.39237310591017],"size":[224.38393130138115,447.83793429247373],"flags":{},"order":4,"mode":0,"inputs":[],"outputs":[],"title":"Models","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["## Main Model\n\nKrea 2 RAW.\n\n[Bf16 & FP8 versions](https://huggingface.co/Comfy-Org/Krea-2/tree/main/diffusion_models)\n\n[GGUF versions](https://huggingface.co/vantagewithai/Krea-2-Raw-GGUF/tree/main)\n\nUse the RAW model for this workflow, not the turbo model.\n\nGoes in models/diffusion_models\n\n## Turbo Lora\n\n[Rank 64 Turbo Lora](https://huggingface.co/Comfy-Org/Krea-2/blob/main/loras/krea2_turbo_lora_rank_64_bf16.safetensors)\n\nRequired when using the RAW model. Set it to 0.6 strength for this workflow.\n\nGoes in models/loras\n\n## Anti-Censorship Lora\n\n[2 Vector Bypass Lora](https://civitai.com/models/2728234/krea2filterbypass?modelVersionId=3066812)\n\nRequired if you want the model to work properly, even for SFW prompts. Set it to only 1.0 strength most of the time, but sometimes you may need to set it higher (2-6) if the model keeps refusing to do what you ask. This is a thing even for SFW prompts, especially when you want strong facial expressions.\n\nGoes in models/loras\n\n## Identity Edit Lora\n\n[Identity Edit Lora](https://huggingface.co/conradlocke/krea2-identity-edit/tree/main)\n\nGoes in models/loras\n\n## Text Encoder\n\n[Qwen 3 VL 4B](https://huggingface.co/Comfy-Org/Krea-2/tree/main/text_encoders)\n\nUse BF16 if you can.\n\nGoes in models/text_encoders\n\n## VAE\n\n[Wan 2.1 FP32 VAE (RECOMMENDED)](https://huggingface.co/Kijai/WanVideo_comfy/blob/main/Wan2_1_VAE_fp32.safetensors)\n\nThe FP32 Wan VAE gives sharp results and has no downsides.\n\n\n[Wan 2.1 Upscale2x VAE (OPTIONAL)](https://huggingface.co/spacepxl/Wan2.1-VAE-upscale2x/blob/main/Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors)\n\nThis gives even sharper results than the regular Wan 2.1 FP32 VAE, but it also introduces noise & artifacts to the image.\n\nTo use it, you need the VAE-Utils Comfy node set installed so you can use the 'VAE Decode (VAE Utils)' node instead of the normal vae decoder. You also need to downscale your image by 0.5 afterwards (the VAE doubles the resolution).\n\n[Qwen Image VAE (OPTIONAL)](https://huggingface.co/Comfy-Org/Krea-2/tree/main/vae)\n\nThe qwen image VAE is the 'normal' one for Krea 2. It gives blurrier results than the Wan 2.1 FP32 VAE, but you may prefer it this way if you plan to post-process your images.\n\nGoes in models/vae"],"color":"#233","bgcolor":"#355"},{"id":264,"type":"easy int","pos":[-683.0341811148295,561.1722345185449],"size":[210,58],"flags":{},"order":5,"mode":0,"inputs":[],"outputs":[{"name":"int","type":"INT","links":[1150]}],"title":"Input Scale","properties":{"cnr_id":"comfyui-easy-use","ver":"130c1b5796d9876a5f853fa0bea88e808cfda4ad","Node name for S&R":"easy int","aux_id":"yolain/ComfyUI-Easy-Use"},"widgets_values":[1920],"color":"#2a363b","bgcolor":"#3f5159"},{"id":288,"type":"PrimitiveBoolean","pos":[-913.6935751508744,559.7344298320012],"size":[210,58],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[{"name":"BOOLEAN","type":"BOOLEAN","links":[1441]}],"title":"Scale Input Image?","properties":{"cnr_id":"comfy-core","ver":"0.21.1","Node name for S&R":"PrimitiveBoolean"},"widgets_values":[true],"color":"#2a363b","bgcolor":"#3f5159"},{"id":327,"type":"MarkdownNote","pos":[-343.30615678432514,-333.2918135458014],"size":[231.31632049995255,182.53855325636783],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"title":"Important Loras","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["**TURBO LORA**\n\nUse the raw main model, and always leave the turbo lora on at 0.6 strength.\n\n**2 VECTOR FILTER BYPASS LORA**\n\nSet it to 1.0 strength for most things. Leave it on even when you're using NSFW loras (but don't go higher than 1.0 then).\n\nIt will degrade image quality past 1.0 strength, which is why you usually don't want to go higher.\n\nYou can also use NSFW loras to improve prompt adherence *even for SFW prompts*.\n\nNew finetunes and loras will probably help in the future.\n\n**IDENTITY EDIT LORA**\n\nNeeded for the edit functionality! Use it at 1.0 strength."],"color":"#233","bgcolor":"#355"},{"id":329,"type":"MarkdownNote","pos":[-776.9579676485534,-236.134269751457],"size":[228.0560827570057,88],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"GGUFs?","properties":{"ue_properties":{"version":"7.5.2","widget_ue_connectable":{},"input_ue_unconnectable":{}}},"widgets_values":["If you're using a GGUF model, swap the model loader node to a \"Unet Loader (GGUF)\" node instead. You need the 'ComfyUI-GGUF' custom nodes installed to do that."],"color":"#233","bgcolor":"#355"},{"id":321,"type":"easy float","pos":[-683.7072241720593,662.7070603909115],"size":[210,58],"flags":{},"order":9,"mode":0,"inputs":[],"outputs":[{"name":"float","type":"FLOAT","links":[1472,1479]}],"title":"CFG","properties":{"cnr_id":"comfyui-easy-use","ver":"5ec3b5ef861fe45c4e9966d17c4546e943417723","Node name for S&R":"easy float","aux_id":"yolain/ComfyUI-Easy-Use"},"widgets_values":[1],"color":"#2a363b","bgcolor":"#3f5159"},{"id":262,"type":"LayerUtility: ImageScaleByAspectRatio","pos":[-260.21521759193155,505.82924847454683],"size":[295.1333374023437,306],"flags":{"collapsed":true},"order":13,"mode":0,"inputs":[{"name":"image","shape":7,"type":"IMAGE","link":1152},{"name":"mask","shape":7,"type":"MASK","link":null},{"name":"scale_to_longest_side","type":"BOOLEAN","widget":{"name":"scale_to_longest_side"},"link":1441},{"name":"longest_side","type":"INT","widget":{"name":"longest_side"},"link":1150}],"outputs":[{"name":"image","type":"IMAGE","links":[1440,1474,1475]},{"name":"mask","type":"MASK","links":null},{"name":"original_size","type":"BOX","links":null},{"name":"width","type":"INT","links":null},{"name":"height","type":"INT","links":null}],"properties":{"cnr_id":"comf